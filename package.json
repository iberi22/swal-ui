{
  "name": "@swal/ui",
  "version": "0.2.1",
  "private": false,
  "description": "SWAL Design System — Edge-Hive theme, Svelte 5 components (zero-dependency, scoped CSS)",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "dev": "vite dev demo",
    "preview": "vite preview",
    "test": "vitest run -c vite.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "themes:audit": "node scripts/themes-audit.mjs",
    "themes:ecosistema": "node scripts/themes-audit.mjs --ecosistema",
    "check": "node scripts/themes-audit.mjs",
    "gen:flutter": "node scripts/gen-flutter-tokens.mjs"
  },
  "svelte": "./src/components/index.js",
  "exports": {
    ".": {
      "types": "./src/components/index.d.ts",
      "svelte": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./antigravity.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/antigravity.css"
    },
    "./backup": {
      "types": "./src/lib/backup.d.ts",
      "default": "./src/lib/backup.js"
    },
    "./bone-taller.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/bone-taller.css"
    },
    "./colors": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/colors.css"
    },
    "./components/*.svelte": {
      "types": "./src/components/component.d.ts",
      "svelte": "./src/components/*.svelte"
    },
    "./fonts.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/fonts.css"
    },
    "./icons": {
      "types": "./src/lib/icons.d.ts",
      "default": "./src/lib/icons.js"
    },
    "./motion": {
      "types": "./src/lib/motion.d.ts",
      "default": "./src/lib/motion.js"
    },
    "./nav": {
      "types": "./src/lib/nav.d.ts",
      "default": "./src/lib/nav.js"
    },
    "./prefs": {
      "types": "./src/lib/prefs/index.d.ts",
      "default": "./src/lib/prefs/index.js"
    },
    "./storage": {
      "types": "./src/lib/storage.d.ts",
      "default": "./src/lib/storage.js"
    },
    "./taller.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/taller.css"
    },
    "./theme-boot": {
      "types": "./src/lib/theme-boot.d.ts",
      "default": "./src/lib/theme-boot.js"
    },
    "./theme-mode": {
      "types": "./src/lib/themeMode.d.ts",
      "default": "./src/lib/themeMode.js"
    },
    "./themes.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/themes.css"
    },
    "./tikpro.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/tikpro.css"
    },
    "./toast": {
      "types": "./src/lib/toast.d.ts",
      "default": "./src/lib/toast.svelte.js"
    },
    "./tokens": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/theme.css"
    },
    "./tokens.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/theme.css"
    },
    "./tokens/antigravity.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/antigravity.css"
    },
    "./tokens/bone-taller.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/bone-taller.css"
    },
    "./tokens/fonts.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/fonts.css"
    },
    "./tokens/taller.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./src/tokens/taller.css"
    },
    "./ui.css": {
      "types": "./src/tokens/css.d.ts",
      "default": "./dist/ui.css"
    }
  },
  "files": [
    "src/components/",
    "src/lib/",
    "src/layouts/",
    "src/styles/",
    "src/tokens/",
    "src/themes.css",
    "scripts/check-vendored-drift.mjs",
    "README.md",
    "USAGE.md",
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "swal",
    "design-system",
    "svelte",
    "svelte5",
    "ui",
    "components",
    "css-tokens",
    "design-tokens",
    "astro",
    "accessibility",
    "wcag",
    "bone-theme",
    "tailwind"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "eslint": "^9.39.5",
    "jsdom": "30.1.2",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/iberi22/swal-ui",
  "bugs": {
    "url": "https://github.com/iberi22/swal-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/swal-ui.git",
    "directory": "."
  },
  "author": "SouthWest AI Labs (SWAL) <belal@iberi22.com>",
  "contributors": [
    "SouthWest AI Labs (SWAL)"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "swal-check-vendored-drift": "./scripts/check-vendored-drift.mjs"
  }
}
