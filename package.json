{
  "name": "@swal/ui",
  "version": "0.2.0",
  "private": false,
  "description": "SWAL Design System — Edge-Hive theme, Svelte 5 components (zero-dependency, scoped CSS)",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm run build",
    "dev": "vite dev demo",
    "preview": "vite preview",
    "test": "vitest run -c vite.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "themes:audit": "node scripts/themes-audit.mjs",
    "themes:ecosistema": "node scripts/themes-audit.mjs --ecosistema",
    "check": "node scripts/themes-audit.mjs"
  },
  "svelte": "./src/components/index.js",
  "exports": {
    ".": {
      "svelte": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./antigravity.css": "./src/tokens/antigravity.css",
    "./colors": "./src/tokens/colors.css",
    "./components/*.svelte": {
      "svelte": "./src/components/*.svelte"
    },
    "./fonts.css": "./src/tokens/fonts.css",
    "./motion": "./src/lib/motion.js",
    "./prefs": {
      "types": "./src/lib/prefs/index.d.ts",
      "default": "./src/lib/prefs/index.js"
    },
    "./taller.css": "./src/tokens/taller.css",
    "./theme-mode": "./src/lib/themeMode.js",
    "./themes.css": "./src/themes.css",
    "./tikpro.css": "./src/tokens/tikpro.css",
    "./toast": "./src/lib/toast.svelte.js",
    "./tokens": "./src/tokens/theme.css",
    "./tokens/antigravity.css": "./src/tokens/antigravity.css",
    "./tokens/fonts.css": "./src/tokens/fonts.css",
    "./tokens/taller.css": "./src/tokens/taller.css",
    "./ui.css": "./dist/ui.css"
  },
  "files": [
    "src",
    "README.md",
    "USAGE.md",
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "swal",
    "design-system",
    "svelte",
    "svelte5",
    "ui",
    "components",
    "css-tokens",
    "design-tokens",
    "astro",
    "accessibility",
    "wcag",
    "bone-theme",
    "tailwind"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.9.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/iberi22/swal-ui",
  "bugs": {
    "url": "https://github.com/iberi22/swal-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/swal-ui.git",
    "directory": "."
  },
  "author": "SouthWest AI Labs (SWAL) <belal@iberi22.com>",
  "contributors": [
    "SouthWest AI Labs (SWAL)"
  ],
  "engines": {
    "node": ">=18"
  }
}
